<?xml version="1.0" encoding="utf-8" ?>
<osmand_routing_config defaultProfile="pedestrian-shade_routing" name="shade-1">
    <routingProfile name="pedestrian-shade_routing" baseProfile="pedestrian" restrictionsAware="false" minSpeed="2" defaultSpeed="4" maxSpeed="10" sharpTurn="0" slightTurn="0" followSpeedLimitations="false" onewayAware="false">

        <!-- NEW ROUTING API -->
        <parameter id="hour" name="Hour" description="Hour" type="numeric" values="0,1,2,3,4,5,6,7,10" valueDescriptions="0h,1h,2h,3h,4h,5h,6h,7h,10h"/>

        <!-- DÉFINITION DU COÛT DE BASE a revoir-->
        <cost name="weight">
            <init value="1.0"/>
        </cost>

        <!-- BOUCLE : on applique le shade correspondant à l’heure choisie -->

        <!-- shade0 -->
        <if condition="param('hour') = 0">
            <set attr="weight" type="multiply" value="(1 - tag('shade0') / 100.0)"/>
        </if>

        <!-- shade1 -->
        <if condition="param('hour') = 1">
            <set attr="weight" type="multiply" value="(1 - tag('shade1') / 100.0)"/>
        </if>

        <!-- shade2 -->
        <if condition="param('hour') = 2">
            <set attr="weight" type="multiply" value="(1 - tag('shade2') / 100.0)"/>
        </if>

        <if condition="param('hour') = 3">
            <set attr="weight" type="multiply" value="(1 - tag('shade3') / 100.0)"/>
        </if>

        <if condition="param('hour') = 4">
            <set attr="weight" type="multiply" value="(1 - tag('shade4') / 100.0)"/>
        </if>

        <if condition="param('hour') = 5">
            <set attr="weight" type="multiply" value="(1 - tag('shade5') / 100.0)"/>
        </if>

        <if condition="param('hour') = 10">
            <set attr="weight" type="multiply" value="(1 - tag('shade10') / 100.0)"/>
        </if>

        <if condition="param('hour') = 23">
            <set attr="weight" type="multiply" value="(1 - tag('shade23') / 100.0)"/>
        </if>

    </routingProfile>
</osmand_routing_config>